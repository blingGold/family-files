# =====================================================
# 家庭病历档案管理系统 - 环境变量模板
# 部署方式：cp .env.example .env  → 编辑 .env 填入真实值 → docker compose up -d --build
# 注意：.env 含密钥，已被 .gitignore 排除，切勿提交到 GitHub
# =====================================================

# ---- 数据库（容器内固定指向数据卷，无需修改）----
DATABASE_URL="file:/data/db/dev.db"

# ---- 认证 ----
# 生产环境务必改成足够长的随机字符串（可用：openssl rand -hex 32 生成）
JWT_SECRET="change-me-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"

# ---- 服务 ----
PORT=3000

# 上传目录（容器内固定指向数据卷，无需修改）
UPLOAD_DIR="/data/uploads"

# 复查提醒提前天数：到期日前 N 天进入提醒中心
LEAD_DAYS=30

# ---- OCR 大模型识别（DeepSeek，OpenAI 兼容接口）----
OCR_API_BASE="https://api.deepseek.com"
# 填入你自己的 DeepSeek API Key（sk-...）
OCR_API_KEY="sk-你的key"
OCR_MODEL="deepseek-chat"

# ---- 首次部署的初始管理员密码（seed 时生效）----
# 提示：seed 使用 upsert，只会创建/更新 admin 用户，不会影响其他数据
SEED_ADMIN_PASSWORD="请改成强密码"

# ---- Docker Compose 参数 ----
# 对外暴露的 Web 端口（默认 8080，访问 http://服务器IP:8080）
WEB_PORT=8080
# 镜像标签：升级版本时改这里，如 v1.1.0（数据不受影响）
TAG=latest
